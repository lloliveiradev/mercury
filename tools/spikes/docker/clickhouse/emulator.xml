<clickhouse>
    <!-- The emulator certificate is valid for 127.0.0.1 only, and it changes every start. -->
    <openSSL>
        <client>
            <caConfig>/etc/clickhouse-server/emulator-ca.pem</caConfig>
            <verificationMode>strict</verificationMode>
        </client>
    </openSSL>
    <s3>
        <emulator>
            <endpoint>https://127.0.0.1:9297/</endpoint>
            <region>us-east-1</region>
        </emulator>
    </s3>
</clickhouse>
